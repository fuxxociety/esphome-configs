---
- timing: !include click-single.yaml
  then:
    - homeassistant.event:
        event: esphome.button
        data:
          device: ${name}
          action: single
    - text_sensor.template.publish:
        id: ${name}
        state: !lambda 'return "single";'
- timing: !include click-double.yaml
  then:
    - homeassistant.event:
        event: esphome.button
        data:
          device: ${name}
          action: double
    - text_sensor.template.publish:
        id: ${name}
        state: !lambda 'return "double";'
- timing: !include click-triple.yaml
  then:
    - homeassistant.event:
        event: esphome.button
        data:
          device: ${name}
          action: triple
    - text_sensor.template.publish:
        id: ${name}
        state: !lambda 'return "triple";'
- timing: !include click-quad.yaml
  then:
    - button.press: restart_button
- timing: !include click-hold.yaml
  then:
    - homeassistant.event:
        event: esphome.button
        data:
          device: ${name}
          action: hold
    - text_sensor.template.publish:
        id: ${name}
        state: !lambda 'return "hold";'

