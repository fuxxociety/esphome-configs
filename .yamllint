extends: default

ignore: |
  .esphome/
  .git/
  reference/
  kauf-rgbww-bulbs/

rules:
  # ESPHome tags (!include, !secret, !lambda, !extend, !remove) are fine
  truthy: disable
  document-start: disable
  comments:
    min-spaces-from-content: 1
  line-length:
    max: 160
    level: warning
  indentation:
    spaces: 2
    indent-sequences: consistent
