# Copy to secrets.yaml and fill in. Keep in sync with .github/secrets.ci.yaml (same keys).
wifi_ssid: "your-ssid"
wifi_password: "changeme"
wifi_dns_domain: ".example.lan"   # must start with a dot
ap_password: "changeme"
api_enc_key: "base64 32-byte key (esphome generates one in the dashboard)"
esphome_api_password: "legacy, only used by unmigrated configs"
esphome_ota_password: "changeme"
esphome_web_server_username: "admin"
esphome_web_server_password: "changeme"
my_wifi_ssid: "legacy, only used by an unmigrated config"
my_wifi_pass: "legacy, only used by an unmigrated config"
